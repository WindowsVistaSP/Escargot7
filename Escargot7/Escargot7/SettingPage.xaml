<phone:PhoneApplicationPage 
    x:Class="Escargot7.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d" d:DesignHeight="768" d:DesignWidth="480"
    shell:SystemTray.IsVisible="True" xmlns:my="clr-namespace:Coding4Fun.Phone.Controls;assembly=Coding4Fun.Phone.Controls" xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit">


    <!--动画-->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <!-- 从其他页面返回时，使用 SwivelTransition 的 BackwardIn 模式 -->
                <toolkit:SwivelTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <!-- 从其他页面首次进入时，使用 SwivelTransition 的 ForwardIn 模式 -->
                <toolkit:SwivelTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <!-- 按返回键离开当前页面时，使用 SwivelTransition 的 BackwardOut 模式 -->
                <toolkit:SwivelTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <!-- 向前导航离开当前页面时，使用 SwivelTransition 的 ForwardOut 模式 -->
                <toolkit:SwivelTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>



    <!--LayoutRoot 是包含所有页面内容的根网格-->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--TitlePanel 包含应用程序的名称和页标题-->
        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,28">
            <TextBlock x:Name="ApplicationTitle" Text="Escargot7" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="设置" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!--ContentPanel - 在此处放置其他内容-->
        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="12,0,12,0">

            <ScrollViewer Height="502" HorizontalAlignment="Left" Name="scrollViewer1" VerticalAlignment="Top" Width="456" Grid.Row="1">
                <Grid Name="grid4" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.RowSpan="2">
                    <TextBlock Height="30" HorizontalAlignment="Left" Name="textBlock1" Text="服务器(DS/NS):" VerticalAlignment="Top" />
                    <TextBox Height="72" HorizontalAlignment="Left" Margin="0,36,0,0" Name="textBox1" Text="143.198.4.104" VerticalAlignment="Top" Width="316" TextChanged="textBox1_TextChanged">
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Url"/>
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>
                    <TextBox Height="72" HorizontalAlignment="Right" Margin="0,36,0,0" Name="textBox2" Text="1863" VerticalAlignment="Top" Width="143" TextChanged="textBox2_TextChanged">
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Digits"/>
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>
                    <TextBlock Height="30" HorizontalAlignment="Right" Margin="0,56,141,0" Name="textBlock2" Text=":" VerticalAlignment="Top" />
                    <TextBlock Height="30" HorizontalAlignment="Left" Margin="64,328,0,0" Name="textBlock3" Text="" VerticalAlignment="Top" />
                    <toolkit:ToggleSwitch Header="记住密码" Height="111" HorizontalAlignment="Left" Name="toggleSwitch1" VerticalAlignment="Top" Width="456" Margin="0,114,0,0" Checked="toggleSwitch1_Checked" Unchecked="toggleSwitch1_Unchecked" />
                    <toolkit:ToggleSwitch Header="下次启动时自动登录" Height="111" HorizontalAlignment="Left" Name="toggleSwitch2" VerticalAlignment="Top" Width="456" Margin="0,231,0,0" Checked="toggleSwitch2_Checked" Unchecked="toggleSwitch2_Unchecked" IsEnabled="False" />
                    <toolkit:ToggleSwitch Header="保存聊天记录" Height="111" HorizontalAlignment="Left" Name="toggleSwitch3" VerticalAlignment="Top" Width="456" Margin="0,348,0,0" IsEnabled="False"/>
                    <Button Content="使用默认配置" Height="82" HorizontalAlignment="Left" Margin="0,553,0,0" Name="button1" VerticalAlignment="Top" Width="444" Click="button1_Click_1" />
                    <Button Content="删除聊天记录" Height="82" HorizontalAlignment="Left" Margin="0,465,0,0" Name="button2" VerticalAlignment="Top" Width="444" IsEnabled="False" />
                </Grid>
            </ScrollViewer>

            <Grid Height="104" Name="grid1" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <my:RoundButton Content="保存" Height="91" HorizontalAlignment="Center" Name="roundButton1" VerticalAlignment="Top" Width="74" Margin="155,0,227,0" ImageSource="/Escargot7;component/images/rbton/ok.png" Click="roundButton1_Click" />
                <my:RoundButton Content="取消" Height="91" HorizontalAlignment="Center" Name="roundButton3" VerticalAlignment="Top" Width="74" Margin="231,0,151,0" ImageSource="/Escargot7;component/images/rbton/close.png" Click="roundButton3_Click" />
            </Grid>
        </Grid>
    </Grid>

    <!--演示 ApplicationBar 用法的示例代码-->
    <!--<phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button1.png" Text="按钮 1"/>
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button2.png" Text="按钮 2"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="菜单项 1"/>
                <shell:ApplicationBarMenuItem Text="菜单项 2"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>-->

</phone:PhoneApplicationPage>
