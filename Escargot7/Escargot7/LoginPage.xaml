<phone:PhoneApplicationPage 
    x:Class="Escargot7.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d" d:DesignHeight="768" d:DesignWidth="480"
    shell:SystemTray.IsVisible="True" xmlns:my="clr-namespace:Coding4Fun.Phone.Controls;assembly=Coding4Fun.Phone.Controls" xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit">


    <!--动画-->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <!-- 从其他页面返回时，使用 SwivelTransition 的 BackwardIn 模式 -->
                <toolkit:SwivelTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <!-- 从其他页面首次进入时，使用 SwivelTransition 的 ForwardIn 模式 -->
                <toolkit:SwivelTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <!-- 按返回键离开当前页面时，使用 SwivelTransition 的 BackwardOut 模式 -->
                <toolkit:SwivelTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <!-- 向前导航离开当前页面时，使用 SwivelTransition 的 ForwardOut 模式 -->
                <toolkit:SwivelTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>



    <!--LayoutRoot 是包含所有页面内容的根网格-->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--TitlePanel 包含应用程序的名称和页标题-->
        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,28">
            <TextBlock x:Name="ApplicationTitle" Text="Escargot7" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="登录" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!--ContentPanel - 在此处放置其他内容-->
        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="12,0,12,0">
            <Grid Height="502" Name="grid4" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,103">
                <TextBlock Height="30" HorizontalAlignment="Left" Margin="0,-2,0,0" Name="textBlock1" Text="用户名:" VerticalAlignment="Top" />
                <toolkit:PhoneTextBox Height="72" HorizontalAlignment="Left" Margin="0,34,0,0" Name="phoneTextBox1" VerticalAlignment="Top" Width="450" Hint="例如example@escargot.chat" HidesActionItemWhenEmpty="False" TextChanged="phoneTextBox1_TextChanged">
                    <TextBox.InputScope>
                        <InputScope>
                            <InputScope.Names>
                                <InputScopeName NameValue="EmailSmtpAddress"/>
                            </InputScope.Names>
                        </InputScope>
                    </TextBox.InputScope>
                </toolkit:PhoneTextBox>
                <TextBlock Height="30" HorizontalAlignment="Left" Margin="0,113,0,0" Name="textBlock2" Text="密码:" VerticalAlignment="Top" />
                <PasswordBox Height="72" HorizontalAlignment="Left" Margin="0,149,0,0" Name="passwordBox1" VerticalAlignment="Top" Width="450" PasswordChanged="passwordBox1_PasswordChanged" />
                <CheckBox Content="下次启动时自动登录" Height="72" HorizontalAlignment="Left" Margin="0,316,0,0" Name="checkBox1" VerticalAlignment="Top" Width="450" IsEnabled="False" />
                <CheckBox Content="记住密码" Height="72" HorizontalAlignment="Left" Margin="0,238,0,0" Name="checkBox2" VerticalAlignment="Top" Width="450" Checked="checkBox2_Checked" Unchecked="checkBox2_Unchecked" />
                <my:ProgressOverlay HorizontalAlignment="Left" Margin="0,-2,0,0" Name="progressOverlay1" VerticalAlignment="Top" Height="504" Width="456">
                    <my:ProgressOverlay.Content>
                        <StackPanel>
                            <TextBlock Text="登录中..." TextAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" />
                        </StackPanel>
                    </my:ProgressOverlay.Content>
                </my:ProgressOverlay>
            </Grid>
            <Grid Height="104" Name="grid1" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <my:RoundButton Content="登录" Height="91" HorizontalAlignment="Center" Name="roundButton2" VerticalAlignment="Top" Width="74" ImageSource="/Escargot7;component/images/rbton/key.png" Click="roundButton2_Click" />
                <my:RoundButton Content="设置" Height="91" HorizontalAlignment="Center" Name="roundButton1" VerticalAlignment="Top" Width="74" Margin="113,0,262,0" ImageSource="/Escargot7;component/images/rbton/setting.png" Click="roundButton1_Click" />
                <my:RoundButton Content="取消" Height="91" HorizontalAlignment="Center" Name="roundButton3" VerticalAlignment="Top" Width="74" Margin="261,0,114,0" ImageSource="/Escargot7;component/images/rbton/close.png" Click="roundButton3_Click" />
            </Grid>
        </Grid>
    </Grid>
 
    <!--演示 ApplicationBar 用法的示例代码-->
    <!--<phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button1.png" Text="按钮 1"/>
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button2.png" Text="按钮 2"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="菜单项 1"/>
                <shell:ApplicationBarMenuItem Text="菜单项 2"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>-->

</phone:PhoneApplicationPage>
