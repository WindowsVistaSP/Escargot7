<phone:PhoneApplicationPage 
    x:Class="Escargot7.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d" d:DesignHeight="768" d:DesignWidth="480"
    shell:SystemTray.IsVisible="True" xmlns:my="clr-namespace:Coding4Fun.Phone.Controls;assembly=Coding4Fun.Phone.Controls" xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit">


    <!--动画-->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <!-- 从其他页面返回时，使用 SwivelTransition 的 BackwardIn 模式 -->
                <toolkit:SwivelTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <!-- 从其他页面首次进入时，使用 SwivelTransition 的 ForwardIn 模式 -->
                <toolkit:SwivelTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <!-- 按返回键离开当前页面时，使用 SwivelTransition 的 BackwardOut 模式 -->
                <toolkit:SwivelTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <!-- 向前导航离开当前页面时，使用 SwivelTransition 的 ForwardOut 模式 -->
                <toolkit:SwivelTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>



    <!--LayoutRoot 是包含所有页面内容的根网格-->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--TitlePanel 包含应用程序的名称和页标题-->
        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,28">
            <TextBlock x:Name="ApplicationTitle" Text="Escargot7" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="PageTitle" Text="聊天" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!--ContentPanel - 在此处放置其他内容-->
        <Grid x:Name="ContentPanel" Grid.Row="1" Margin="12,0,12,0">
            <Grid Height="502" Name="grid4" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,103"></Grid>
            <Grid Height="104" Name="grid1" Width="456" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <my:RoundButton Content="发送" Height="91" HorizontalAlignment="Center" Name="roundButton2" VerticalAlignment="Top" Width="74" ImageSource="/Escargot7;component/images/rbton/chat.png" Click="roundButton2_Click" />
                <my:RoundButton Content="添加为好友" Height="91" HorizontalAlignment="Center" Name="roundButton1" VerticalAlignment="Top" Width="74" Margin="113,0,262,0" ImageSource="/Escargot7;component/images/rbton/add.png" Click="roundButton1_Click" />
                <my:RoundButton Content="退出" Height="91" HorizontalAlignment="Center" Name="roundButton3" VerticalAlignment="Top" Width="74" Margin="261,0,114,0" ImageSource="/Escargot7;component/images/rbton/close.png" Click="roundButton3_Click" />
            </Grid>
        </Grid>
        <Grid Height="113" HorizontalAlignment="Left" Margin="12,2,0,0" Name="grid2" VerticalAlignment="Top" Width="456" Grid.Row="1">
            <Image Height="80" HorizontalAlignment="Center" Margin="10,10,366,0" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="80" />
            <TextBlock FontSize="32" Height="48" HorizontalAlignment="Left" Margin="105,12,0,0" Name="textBlock1" Text="昵称" TextTrimming="WordEllipsis" TextWrapping="NoWrap" VerticalAlignment="Top" Width="345" />
            <TextBlock FontSize="18" Height="32" HorizontalAlignment="Left" Margin="105,59,0,0" Name="textBlock2" Text="用户名" TextTrimming="WordEllipsis" TextWrapping="NoWrap" VerticalAlignment="Top" Width="345" />
        </Grid>
        <Grid Height="136" HorizontalAlignment="Left" Margin="12,368,0,0" Name="grid3" VerticalAlignment="Top" Width="456" Grid.Row="1">
            <toolkit:PhoneTextBox Height="136" HorizontalAlignment="Left" Name="phoneTextBox1" Text="" VerticalAlignment="Top" Width="456" Hint="输入内容..." TextWrapping="Wrap" TextChanged="phoneTextBox1_TextChanged" />
        </Grid>
        <Grid Height="241" HorizontalAlignment="Left" Margin="12,121,0,0" Name="grid5" VerticalAlignment="Top" Width="456" Grid.Row="1"></Grid>
        <ScrollViewer Height="241" HorizontalAlignment="Left" Margin="12,121,0,0" Name="scrollViewer1" VerticalAlignment="Top" Width="456" Grid.Row="1">
            <StackPanel Name="stackPanel1" Width="456" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
 
    <!--演示 ApplicationBar 用法的示例代码-->
    <!--<phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button1.png" Text="按钮 1"/>
            <shell:ApplicationBarIconButton IconUri="/Images/appbar_button2.png" Text="按钮 2"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="菜单项 1"/>
                <shell:ApplicationBarMenuItem Text="菜单项 2"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>-->

</phone:PhoneApplicationPage>
